{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/undangan-app/browser",
  "functions": {
    "api/og.mjs": {
      "includeFiles": "public/assets/scrapbook-kebun-senja.jpg"
    }
  },
  "routes": [
    {
      "src": "^/undangan/([a-z0-9-]+)/([a-z0-9-]+)/?$",
      "dest": "/undangan/$1/$2/index.html",
      "check": true
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
